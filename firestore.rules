rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isScore(v) {
      return v is int && v >= 0 && v <= 100;
    }

    // Score minimum accessible = 100 - niveau d'accréditation (ex. accréditation 20 → documents ≥ 80)
    function canReadScore(score) {
      return isAdmin() || (signedIn() && request.auth.token.clearance is int
        && score >= 100 - request.auth.token.clearance);
    }

    function canReadDocument(docId) {
      return canReadScore(get(/databases/$(database)/documents/documents/$(docId)).data.score);
    }

    function isCount(v) {
      return v is int && v >= 0;
    }

    // Domaines d'expertise (miroir de src/utils/expertise.ts et functions/index.js)
    function isDomain(v) {
      return v in ['cybersecurite', 'droit-affaires', 'donnees-personnelles', 'conformite', 'finance',
                   'fiscalite', 'rh', 'infrastructure', 'developpement', 'operations'];
    }

    function validDocument(d) {
      return d.keys().hasAll(['title', 'fileName', 'mimeType', 'sizeBytes', 'sha256', 'authorId', 'version',
                              'score', 'previousScore', 'delta', 'volatility', 'signals', 'conflictsWith', 'reviewRequested'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.sizeBytes is int && d.sizeBytes >= 0
        && d.sha256 is string && d.sha256.size() == 64
        && d.version is int && d.version >= 1
        && isScore(d.score) && isScore(d.previousScore) && isScore(d.volatility)
        && d.delta is int && d.delta >= -100 && d.delta <= 100
        && isCount(d.signals.expertValidations) && isCount(d.signals.successfulUses)
        && isCount(d.signals.views) && isCount(d.signals.confirmations) && isCount(d.signals.contradictions)
        && d.conflictsWith is list && d.reviewRequested is bool
        // Facultatif pour les documents créés avant l'introduction des domaines
        && (!('domain' in d) || isDomain(d.domain));
    }

    // Une ligne du journal des mouvements : la variation doit être cohérente avec les scores
    function validScoreEvent(e) {
      return e.keys().hasAll(['score', 'previousScore', 'delta', 'source', 'reason', 'at'])
        && isScore(e.score) && isScore(e.previousScore)
        && e.delta == e.score - e.previousScore
        && e.source in ['initial', 'expert', 'usage', 'freshness', 'consistency', 'contradiction', 'manual']
        && e.reason is string && e.reason.size() <= 300
        && e.at is timestamp;
    }

    // Un utilisateur lit son propre profil, l'admin lit tous les profils.
    // Aucune écriture côté client : tout passe par les Cloud Functions.
    match /profiles/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    // Les requêtes doivent filtrer sur score >= minScoreFor(clearance), sinon elles sont refusées
    match /documents/{docId} {
      allow read: if canReadScore(resource.data.score);
      allow create, update: if isAdmin() && validDocument(request.resource.data);
      allow delete: if isAdmin();

      // Fichier en base64 ; limite Firestore de 1 Mio par document
      match /content/{contentId} {
        allow read: if canReadDocument(docId);
        allow write: if isAdmin()
          && request.resource.data.base64 is string
          && request.resource.data.base64.size() <= 1000000;
        allow delete: if isAdmin();
      }

      // Historique des scores : ajout uniquement, jamais modifié
      match /scoreHistory/{eventId} {
        allow read: if canReadDocument(docId);
        allow create: if isAdmin() && validScoreEvent(request.resource.data);
        allow update, delete: if false;
      }

      // Une validation par utilisateur (id = uid), écrite uniquement par la Cloud Function validateDocument
      match /validations/{uid} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow write: if false;
      }
    }

    // Notes d'expertise par domaine : l'intéressé et l'admin lisent, validateDocument / rebuildExpertise écrivent.
    // Les autres utilisateurs ne voient les experts qu'au travers de la Cloud Function recommendExperts.
    // Écriture admin autorisée pour les experts de démonstration (scripts/seed-experts.mjs).
    match /expertise/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Demandes de revue (id = {documentId}_{expertId}) : visibles par l'expert sollicité, le demandeur et l'admin.
    // Création et changements de statut uniquement via requestReview / respondReviewRequest / validateDocument.
    match /reviewRequests/{requestId} {
      allow read: if isAdmin()
        || (signedIn() && (resource.data.expertId == request.auth.uid || resource.data.requesterId == request.auth.uid));
      allow write: if false;
    }

    // Tableau de bord Trust Radar : lecture pour les connectés, écriture admin (scripts/seed-dashboard.mjs)
    match /health/{statId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /conflicts/{conflictId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /gaps/{gapId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Tout le reste est fermé par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
